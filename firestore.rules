rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerRole() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' ||
        request.auth.token.role == 'owner'
      );
    }

    // User profiles: authenticated members can view team profiles; users can update their own profile; owners can manage all
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isOwnerRole();
    }

    // Shared Apiary Hives: all authenticated members can view, monitor, and manage apiary hives
    match /hives/{hiveId} {
      allow read, write: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Nested user hives (subcollection support)
    match /users/{userId}/hives/{hiveId} {
      allow read, write: if isOwner(userId);
    }

    // AI Prediction Records: authenticated beekeepers can save and review model inference records
    match /predictions/{predictionId} {
      allow read, write: if isAuthenticated();
    }

    // Alerts collection: authenticated members can view alerts and acknowledge/dismiss them
    match /alerts/{alertId} {
      allow read, write: if isAuthenticated();
    }
  }
}
